from collections import deque

monkey = [(0, 1), (1, 0), (0, -1), (-1, 0)]
horse = [(-2, 1), (-1, 2), (1, 2), (2, 1), (2, -1), (1, -2), (-1, -2), (-2, -1)] # 우상부터 시작

def in_range(r, c, H, W):
    return 0 <= r < H and 0 <= c < W

def bfs():
    global min_move
    que = deque()
    que.append((0, 0, 0, 0)) # r, c, 사용한 횟수, 누적 move
    visited[0][0] = 0
    
    while que:
        r, c, used, move = que.popleft()

        if (r, c) == (H - 1, W - 1):
            return move
        
        if used < K:
            # 말 가능
            for hr, hc in horse:
                nr, nc = r + hr, c + hc
                # 인덱스 범위 내이고, 다음 횟수에 대해서 방문한 적 없고, 장애물이 아닐 때
                new_used = used + 1
                if in_range(nr, nc, H, W) and not field[nr][nc]:
                    if new_used < visited[nr][nc]:
                        visited[nr][nc] = new_used
                        que.append((nr, nc, new_used, move + 1))

        # 원숭이 가능
        for mr, mc in monkey:
            nr, nc = r + mr, c + mc
            # 인덱스 범위 내이고, 이번 횟수에 대해서 방문한 적 없고, 장애물이 아닐 때
            new_used = used
            if in_range(nr, nc, H, W) and not field[nr][nc]:
                if new_used < visited[nr][nc]:
                    visited[nr][nc] = new_used
                    que.append((nr, nc, new_used, move + 1))

    return -1

K = int(input())
W, H = map(int, input().split())
field = [
    list(map(int, input().split()))
    for _ in range(H)
]

visited = [
    [K + 1] * W
    for _ in range(H)
]


print(bfs())