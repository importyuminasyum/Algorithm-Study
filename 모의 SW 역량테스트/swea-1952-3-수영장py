def dfs(month, fee):
    global answer

    if fee >= answer:
        return

    if month >= 12:
        answer = min(answer, fee)
        return

    dfs(month + 1, fee + yearly_plan[month] * daily_fee)
    dfs(month + 1, fee + monthly_fee)
    dfs(month + 3, fee + third_monthly_fee)


T = int(input())
for tc in range(1, T+1):
    daily_fee, monthly_fee, third_monthly_fee, answer = map(int, input().split())
    yearly_plan = list(map(int, input().split()))
    dfs(0, 0)
    print(f'#{tc} {answer}')

    '''
